[Unit]
Description=Issue the approved T100 internal gateway connector token
Requires=sysmcp-biz-t100.service
After=sysmcp-biz-t100.service

[Service]
Type=oneshot
WorkingDirectory=/data/projects/sysmcp_dev/projects/biz-t100
ExecStart=/data/projects/sysmcp_dev/projects/biz-t100/.runtime/releases/0.9.2/.venv/bin/sysmcp-t100 issue-gateway-token --config /data/projects/sysmcp_dev/projects/biz-t100/.runtime/service/server-maintenance.json --signing-key /data/projects/sysmcp_dev/projects/biz-t100/.runtime/service/maintenance-signing.pem --subject internal-gateway-maintenance --client-id metamcp-internal-maintenance --output /data/projects/sysmcp_dev/projects/biz-t100/.runtime/exports/metamcp-connector.jwt --lifetime-seconds 3600
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=30
